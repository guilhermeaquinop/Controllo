# Copie para .env.local e preencha.
# Local: `npx supabase status` mostra a URL e a chave publicável (ou anon).
# Produção: painel do Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do app, usado nos links dos e-mails (confirmação e nova senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só para o cron de recorrências (etapa 6). Nunca com prefixo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=
